#!/bin/sh
# Pre-commit. Installed by `yarn install` (scripts/i18n/install-hooks.js sets
# core.hooksPath to this directory). Neither step blocks a commit.
#
# 1. Provider redirects: when the commit touches src/configs/providers.json
#    (or netlify.toml, or the code that derives the rules), regenerate the
#    generated provider redirect block in netlify.toml from the staged catalog
#    and stage it (scripts/precommit-provider-redirects.js).
#    PROVIDER_REDIRECTS_PRECOMMIT=off skips it.
# 2. Translations for the staged source pages (scripts/i18n). Mode comes from
#    scripts/i18n/config.js `precommit` or I18N_PRECOMMIT=warn|translate|off.
node scripts/precommit-provider-redirects.js
node scripts/i18n/precommit.js
